{
  "expo": {
    "name": "Artigen",
    "slug": "artigen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "artigen",
    "description": "AI Art Community - Create, share, and discover AI-generated art",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mukundakatta.artigen",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Artigen needs camera access to capture photos for your AI art creations and profile pictures.",
        "NSPhotoLibraryUsageDescription": "Artigen needs access to your photo library to select images for AI art generation and sharing.",
        "NSPhotoLibraryAddUsageDescription": "Artigen needs permission to save AI-generated artwork to your photo library.",
        "NSMicrophoneUsageDescription": "Artigen needs microphone access to record voice messages in chats.",
        "NSFaceIDUsageDescription": "Use Face ID to securely access your Artigen account.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:artigen.app"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mukundakatta.artigen",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9199ac28-084f-47e1-9b9f-69dcd76da909"
      }
    },
    "owner": "mukundakatta"
  }
}
