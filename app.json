{
  "expo": {
    "name": "Artigen",
    "slug": "artigen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "artigen",
    "description": "AI Art Community - Create, share, and discover AI-generated art",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.instagramclone"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourname.instagramclone"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
